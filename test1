#include <stdio.h>

char board[3][3];//tic tac board
char currentplayer = 'X';

void  setup_board()
{
   for (int i=0;i<3;i++)
   {
       for (int j = 0 ;j<3;j++)
       {
           board[i][j]='1'+(3*i+j);   //Formula for numbering 1- 9
       }
   }
    
}

void make_board()
{
    for (int i =0;i<3;i++)
        {
           for (int j=0;j<3;j++)
               {
                  printf(" %c ",board[i][j]);
                   
                  if (j<2) 
                      printf("|"); //make a line between number
               }
        if (i<2)
           printf("\n --*---*--\n");//make a design after a row
        }
}
